# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_EMAIL=

# Database Configuration (PostgreSQL)
# USE_SQLITE=true  -> temporary local dev without PostgreSQL installed
# USE_SQLITE=false -> use PostgreSQL (requires server running on DB_HOST:DB_PORT)
USE_SQLITE=false
DB_ENGINE=django.db.backends.postgresql
DB_NAME=techledger_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Monime payment configuration
MONIME_API_TOKEN=
MONIME_SPACE_ID=
MONIME_DEFAULT_AMOUNT_MINOR=10000
