# ---------------------------------------------------------------------------
# Local development (copy to .env on your machine)
# ---------------------------------------------------------------------------
USE_SQLITE=true

# Supabase values below are kept for reference; ignored while USE_SQLITE=true.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD="your_supabase_db_password"
DB_HOST=db.cbquedvjjzxrdawyifla.supabase.co
DB_PORT=5432

# ---------------------------------------------------------------------------
# Production (set on hosting platform — do NOT commit .env)
# ---------------------------------------------------------------------------
# USE_SQLITE=false
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD="your_supabase_db_password"
# DB_HOST=db.cbquedvjjzxrdawyifla.supabase.co
# DB_PORT=5432
# DB_CONN_MAX_AGE=0
